{
  "manifest_version": 3,
  "name": "Quick Search Plus",
  "version": "1.2.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "123",
  "homepage_url": "https://github.com/Kaito-Rowing/quick-search-plus",
  "permissions": ["storage", "clipboardWrite"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
